generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  PENDING
  ACTIVE
  DELETE_PENDING
  DELETED
}

enum GenerationStatus {
  PENDING
  SUBMITTING
  SUBMISSION_UNKNOWN
  SUBMITTED
  SUCCEEDED
  FAILED
}

enum BackgroundJobKind {
  GENERATE_IMAGE
  RECONCILE_GENERATION
  DELETE_SOURCE_IMAGE
  DELETE_GENERATED_IMAGE
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  capabilityHash String   @unique
  themeId        String
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  sourceImage    SourceImage?

  @@index([expiresAt])
}

model SourceImage {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @unique @db.Uuid
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  storageKey  String      @unique
  contentType String
  byteSize    Int
  width       Int
  height      Int
  status      AssetStatus @default(ACTIVE)
  deleteAfter DateTime    @db.Timestamptz(3)
  deletedAt   DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  generation  ImageGeneration?

  @@index([status, deleteAfter])
}

model GeneratedImage {
  id           String          @id @default(uuid()) @db.Uuid
  generationId String          @unique @db.Uuid
  generation   ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  storageKey   String          @unique
  contentType  String
  byteSize     Int
  width        Int
  height       Int
  status       AssetStatus     @default(PENDING)
  deleteAfter  DateTime        @db.Timestamptz(3)
  deletedAt    DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, deleteAfter])
}

model ImageGeneration {
  id                   String           @id @db.Uuid
  sourceImageId        String           @unique @db.Uuid
  sourceImage          SourceImage      @relation(fields: [sourceImageId], references: [id], onDelete: Restrict)
  idempotencyKey       String           @unique
  providerGenerationId String?          @unique
  providerOutputUrl    String?
  status               GenerationStatus @default(PENDING)
  generatedImage       GeneratedImage?
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

model DailyGenerationBudget {
  day             DateTime @id @db.Date
  reservedCredits Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

model GenerationCreditReservation {
  generationId String   @id @db.Uuid
  budgetDay    DateTime @db.Date
  credits      Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([budgetDay])
}

model BackgroundJob {
  id             String              @id @default(uuid()) @db.Uuid
  kind           BackgroundJobKind
  status         BackgroundJobStatus @default(QUEUED)
  aggregateId    String              @db.Uuid
  idempotencyKey String              @unique
  attempt        Int                 @default(0)
  maxAttempts    Int                 @default(5)
  nextAttemptAt  DateTime            @default(now()) @db.Timestamptz(3)
  leaseOwner     String?
  leaseExpiresAt DateTime?           @db.Timestamptz(3)
  lastErrorCode  String?
  lastError      String?             @db.Text
  completedAt    DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([kind, aggregateId])
}
