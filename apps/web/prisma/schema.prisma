generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AssetStatus {
  ACTIVE
  DELETE_PENDING
  DELETED
}

enum GenerationStatus {
  PENDING
}

enum BackgroundJobKind {
  GENERATE_IMAGE
  DELETE_SOURCE_IMAGE
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  capabilityHash String   @unique
  themeId        String
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  sourceImage    SourceImage?

  @@index([expiresAt])
}

model SourceImage {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @unique @db.Uuid
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  storageKey  String      @unique
  contentType String
  byteSize    Int
  width       Int
  height      Int
  status      AssetStatus @default(ACTIVE)
  deleteAfter DateTime    @db.Timestamptz(3)
  deletedAt   DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  generation  ImageGeneration?

  @@index([status, deleteAfter])
}

model ImageGeneration {
  id             String      @id @db.Uuid
  sourceImageId  String      @unique @db.Uuid
  sourceImage    SourceImage @relation(fields: [sourceImageId], references: [id], onDelete: Restrict)
  idempotencyKey String      @unique
  status         GenerationStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

model BackgroundJob {
  id             String              @id @default(uuid()) @db.Uuid
  kind           BackgroundJobKind
  status         BackgroundJobStatus @default(QUEUED)
  aggregateId    String              @db.Uuid
  idempotencyKey String              @unique
  attempt        Int                 @default(0)
  maxAttempts    Int                 @default(5)
  nextAttemptAt  DateTime            @default(now()) @db.Timestamptz(3)
  leaseOwner     String?
  leaseExpiresAt DateTime?           @db.Timestamptz(3)
  lastErrorCode  String?
  lastError      String?             @db.Text
  completedAt    DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([kind, aggregateId])
}
