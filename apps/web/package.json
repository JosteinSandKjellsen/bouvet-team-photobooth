{
  "name": "@bouvet-team-photobooth/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "prepare": "nuxt prepare",
    "build": "pnpm db:generate && nuxt build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "pnpm db:require-direct && prisma migrate deploy",
    "db:migrate:dev": "pnpm db:require-direct && prisma migrate dev && pnpm db:generate",
    "db:require-direct": "node --env-file-if-exists=../../.env -e \"if (!process.env.DIRECT_URL) throw new Error('DIRECT_URL is required')\"",
    "db:validate": "prisma validate",
    "start": "node --env-file-if-exists=../../.env ../../scripts/start-production-server.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bouvet-team-photobooth/contracts": "workspace:*",
    "@lucide/vue": "1.55.0",
    "@netlify/blobs": "10.7.13",
    "@netlify/functions": "6.0.2",
    "@nuxtjs/i18n": "10.6.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.7",
    "nuxt": "4.6.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "happy-dom": "20.14.6",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
