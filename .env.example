# Local PostgreSQL started with `docker compose up -d postgres`.
DATABASE_URL="postgresql://photobooth:photobooth@127.0.0.1:54329/photobooth"
DIRECT_URL="postgresql://photobooth:photobooth@127.0.0.1:54329/photobooth"
TEST_DATABASE_URL="postgresql://photobooth:photobooth@127.0.0.1:54329/photobooth_test"
NUXT_CLEANUP_WORKER_TOKEN="local-cleanup-worker-token"
NUXT_GENERATION_WORKER_TOKEN="local-generation-worker-token"
NUXT_SESSION_MAX_ACTIVE="100"
NUXT_SESSION_ORIGIN="http://127.0.0.1:3000"
NUXT_SESSION_TTL_MS="1800000"
NUXT_CAPTURE_GENERATION_ENABLED="false"
NUXT_PUBLIC_CAPTURE_GENERATION_ENABLED="false"
NUXT_PUBLIC_KIOSK_MODE="false"
NUXT_PUBLIC_KIOSK_RESET_MS="60000"
NUXT_PUBLIC_PHOTO_ORIGIN="http://127.0.0.1:3000"
SOURCE_STORAGE_DRIVER="local"
SOURCE_STORAGE_DIR="./.local/sources"
GENERATION_PROVIDER="deterministic"
LEONARDO_API_KEY=""
NUXT_LEONARDO_WEBHOOK_TOKEN=""
